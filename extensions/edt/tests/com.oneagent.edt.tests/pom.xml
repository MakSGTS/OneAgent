<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.oneagent</groupId>
    <artifactId>com.oneagent.edt.parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>com.oneagent.edt.tests</artifactId>
  <packaging>eclipse-test-plugin</packaging>
  <name>OneAgent EDT Tests</name>
  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <configuration>
          <dependency-resolution>
            <extraRequirements>
              <requirement>
                <type>p2-installable-unit</type>
                <id>org.eclipse.equinox.p2.director.app</id>
                <versionRange>0.0.0</versionRange>
              </requirement>
              <requirement>
                <type>p2-installable-unit</type>
                <id>org.eclipse.equinox.p2.transport.ecf</id>
                <versionRange>0.0.0</versionRange>
              </requirement>
              <requirement>
                <type>p2-installable-unit</type>
                <id>org.eclipse.equinox.p2.touchpoint.eclipse</id>
                <versionRange>0.0.0</versionRange>
              </requirement>
              <requirement>
                <type>p2-installable-unit</type>
                <id>org.eclipse.equinox.p2.touchpoint.natives</id>
                <versionRange>0.0.0</versionRange>
              </requirement>
            </extraRequirements>
          </dependency-resolution>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-surefire-plugin</artifactId>
        <configuration>
          <useUIHarness>true</useUIHarness>
          <useUIThread>false</useUIThread>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>macos-ui-main-thread</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.eclipse.tycho</groupId>
            <artifactId>tycho-surefire-plugin</artifactId>
            <configuration>
              <argLine>-XstartOnFirstThread</argLine>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
